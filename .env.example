# Path the app is served from (e.g. /tossv2/). Used by the dev server and applied to the build
# by `npm run build`; change it later without rebuilding via `npm run set-base -- /newpath/`.
VITE_APP_BASE_URL=/tossv2/

# Base URL of the backend REST API. Leave empty to use the bundled mock services.
VITE_API_BASE_URL=

# Set to "true" to force the mock service layer even when VITE_API_BASE_URL is set.
VITE_USE_MOCKS=true

# Simulated latency (ms) applied to mock service responses.
VITE_MOCK_DELAY=250

# Request timeout (ms) for the axios client.
VITE_API_TIMEOUT=30000
